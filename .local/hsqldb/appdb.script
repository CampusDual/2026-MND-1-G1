ALTER TABLE PUBLIC.USERS ALTER COLUMN ID RESTART WITH 1
CREATE MEMORY TABLE PUBLIC.USER_ROLES(USER_ID BIGINT NOT NULL,ROLE_ID BIGINT NOT NULL,CONSTRAINT PK_USER_ROLES PRIMARY KEY(USER_ID,ROLE_ID),CONSTRAINT FK_USER_ROLES_USER FOREIGN KEY(USER_ID) REFERENCES PUBLIC.USERS(ID),CONSTRAINT FK_USER_ROLES_ROLE FOREIGN KEY(ROLE_ID) REFERENCES PUBLIC.ROLES(ID))
CREATE MEMORY TABLE PUBLIC.CENTRO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(120) NOT NULL,TIPO VARCHAR(20) NOT NULL,CIF VARCHAR(20) NOT NULL,DIRECCION VARCHAR(255) NOT NULL,CODIGO_POSTAL VARCHAR(12),LOCALIDAD VARCHAR(120),TELEFONO VARCHAR(30),EMAIL VARCHAR(254),ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,CREADO_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,UNIQUE(CIF),CONSTRAINT CK_CENTRO_TIPO CHECK((PUBLIC.CENTRO.TIPO) IN (('PROPIA'),('CLIENTE'))))
ALTER TABLE PUBLIC.CENTRO ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.ROL(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,NOMBRE VARCHAR(80) NOT NULL,DESCRIPCION VARCHAR(500),UNIQUE(NOMBRE))
ALTER TABLE PUBLIC.ROL ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.PERMISO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CODIGO VARCHAR(120) NOT NULL,DESCRIPCION VARCHAR(500),UNIQUE(CODIGO))
ALTER TABLE PUBLIC.PERMISO ALTER COLUMN ID RESTART WITH 8
CREATE MEMORY TABLE PUBLIC.ROL_PERMISO(ROL_ID BIGINT NOT NULL,PERMISO_ID BIGINT NOT NULL,CONSTRAINT PK_ROL_PERMISO PRIMARY KEY(ROL_ID,PERMISO_ID),CONSTRAINT FK_ROL_PERMISO_ROL FOREIGN KEY(ROL_ID) REFERENCES PUBLIC.ROL(ID),CONSTRAINT FK_ROL_PERMISO_PERMISO FOREIGN KEY(PERMISO_ID) REFERENCES PUBLIC.PERMISO(ID))
CREATE MEMORY TABLE PUBLIC.USUARIO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CENTRO_ID BIGINT NOT NULL,ROL_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,APELLIDOS VARCHAR(160) NOT NULL,DNI VARCHAR(20) NOT NULL,EMAIL VARCHAR(254) NOT NULL,PASSWORD_HASH VARCHAR(255) NOT NULL,FOTO_URL VARCHAR(2048),ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,CREADO_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,UNIQUE(DNI),UNIQUE(EMAIL),CONSTRAINT FK_USUARIO_CENTRO FOREIGN KEY(CENTRO_ID) REFERENCES PUBLIC.CENTRO(ID),CONSTRAINT FK_USUARIO_ROL FOREIGN KEY(ROL_ID) REFERENCES PUBLIC.ROL(ID))
ALTER TABLE PUBLIC.USUARIO ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.TUTOR(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CENTRO_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,APELLIDOS VARCHAR(160) NOT NULL,DNI VARCHAR(20) NOT NULL,EMAIL VARCHAR(254) NOT NULL,TELEFONO VARCHAR(30) NOT NULL,CREADO_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,CONSTRAINT UQ_TUTOR_CENTRO_DNI UNIQUE(CENTRO_ID,DNI),CONSTRAINT FK_TUTOR_CENTRO FOREIGN KEY(CENTRO_ID) REFERENCES PUBLIC.CENTRO(ID))
ALTER TABLE PUBLIC.TUTOR ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.PERSONA_AUTORIZADA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TUTOR_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,TELEFONO VARCHAR(30) NOT NULL,CONSTRAINT FK_PERSONA_AUTORIZADA_TUTOR FOREIGN KEY(TUTOR_ID) REFERENCES PUBLIC.TUTOR(ID))
ALTER TABLE PUBLIC.PERSONA_AUTORIZADA ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.CONTACTO_EMERGENCIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TUTOR_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,TELEFONO VARCHAR(30) NOT NULL,RELACION VARCHAR(80),CONSTRAINT FK_CONTACTO_EMERGENCIA_TUTOR FOREIGN KEY(TUTOR_ID) REFERENCES PUBLIC.TUTOR(ID))
ALTER TABLE PUBLIC.CONTACTO_EMERGENCIA ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.PERRO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CENTRO_ID BIGINT NOT NULL,TUTOR_ID BIGINT,NOMBRE VARCHAR(120) NOT NULL,RAZA VARCHAR(120),FECHA_NACIMIENTO DATE,TAMANO VARCHAR(10) NOT NULL,TEMPERAMENTO VARCHAR(1000),PAUTAS_ALIMENTACION VARCHAR(1000),FOTO_URL VARCHAR(2048),ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,CREADO_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,CONSTRAINT CK_PERRO_TAMANO CHECK((PUBLIC.PERRO.TAMANO) IN (('PEQUENO'),('MEDIANO'),('GRANDE'))),CONSTRAINT FK_PERRO_CENTRO FOREIGN KEY(CENTRO_ID) REFERENCES PUBLIC.CENTRO(ID),CONSTRAINT FK_PERRO_TUTOR FOREIGN KEY(TUTOR_ID) REFERENCES PUBLIC.TUTOR(ID))
ALTER TABLE PUBLIC.PERRO ALTER COLUMN ID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.ALERGIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_ID BIGINT NOT NULL,DESCRIPCION VARCHAR(1000) NOT NULL,CONSTRAINT FK_ALERGIA_PERRO FOREIGN KEY(PERRO_ID) REFERENCES PUBLIC.PERRO(ID))
ALTER TABLE PUBLIC.ALERGIA ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.MEDICACION(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_ID BIGINT NOT NULL,MEDICAMENTO VARCHAR(160) NOT NULL,DOSIS VARCHAR(255),PAUTA VARCHAR(1000) NOT NULL,CONSTRAINT FK_MEDICACION_PERRO FOREIGN KEY(PERRO_ID) REFERENCES PUBLIC.PERRO(ID))
ALTER TABLE PUBLIC.MEDICACION ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.INCOMPATIBILIDAD(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_A_ID BIGINT NOT NULL,PERRO_B_ID BIGINT NOT NULL,MOTIVO VARCHAR(1000),CONSTRAINT CK_INCOMPATIBILIDAD_ORDEN CHECK(PUBLIC.INCOMPATIBILIDAD.PERRO_A_ID<PUBLIC.INCOMPATIBILIDAD.PERRO_B_ID),CONSTRAINT UQ_INCOMPATIBILIDAD_PERROS UNIQUE(PERRO_A_ID,PERRO_B_ID),CONSTRAINT FK_INCOMPATIBILIDAD_PERRO_A FOREIGN KEY(PERRO_A_ID) REFERENCES PUBLIC.PERRO(ID),CONSTRAINT FK_INCOMPATIBILIDAD_PERRO_B FOREIGN KEY(PERRO_B_ID) REFERENCES PUBLIC.PERRO(ID))
ALTER TABLE PUBLIC.INCOMPATIBILIDAD ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.GRUPO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CENTRO_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,SALA VARCHAR(120),CAPACIDAD_MAX INTEGER NOT NULL,CONSTRAINT CK_GRUPO_CAPACIDAD CHECK(PUBLIC.GRUPO.CAPACIDAD_MAX>0),CONSTRAINT UQ_GRUPO_CENTRO_NOMBRE UNIQUE(CENTRO_ID,NOMBRE),CONSTRAINT FK_GRUPO_CENTRO FOREIGN KEY(CENTRO_ID) REFERENCES PUBLIC.CENTRO(ID))
ALTER TABLE PUBLIC.GRUPO ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.BONO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TUTOR_ID BIGINT NOT NULL,DIAS_TOTALES INTEGER NOT NULL,DIAS_RESTANTES INTEGER NOT NULL,CADUCA_EL DATE,CONSTRAINT CK_BONO_DIAS_TOTALES CHECK(PUBLIC.BONO.DIAS_TOTALES>0),CONSTRAINT CK_BONO_DIAS_RESTANTES CHECK((PUBLIC.BONO.DIAS_RESTANTES>=0) AND (PUBLIC.BONO.DIAS_RESTANTES<=PUBLIC.BONO.DIAS_TOTALES)),CONSTRAINT FK_BONO_TUTOR FOREIGN KEY(TUTOR_ID) REFERENCES PUBLIC.TUTOR(ID))
ALTER TABLE PUBLIC.BONO ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.RESERVA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_ID BIGINT NOT NULL,BONO_ID BIGINT,GRUPO_ID BIGINT,FECHA DATE NOT NULL,MODALIDAD VARCHAR(20) NOT NULL,ESTADO VARCHAR(20) DEFAULT 'PENDIENTE' NOT NULL,CREADO_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,CONSTRAINT CK_RESERVA_MODALIDAD CHECK((PUBLIC.RESERVA.MODALIDAD) IN (('DIA_COMPLETO'),('MEDIA_JORNADA'))),CONSTRAINT CK_RESERVA_ESTADO CHECK((PUBLIC.RESERVA.ESTADO) IN (('PENDIENTE'),('CONFIRMADA'),('EN_CURSO'),('COMPLETADA'),('CANCELADA'))),CONSTRAINT UQ_RESERVA_PERRO_FECHA UNIQUE(PERRO_ID,FECHA),CONSTRAINT FK_RESERVA_PERRO FOREIGN KEY(PERRO_ID) REFERENCES PUBLIC.PERRO(ID),CONSTRAINT FK_RESERVA_BONO FOREIGN KEY(BONO_ID) REFERENCES PUBLIC.BONO(ID),CONSTRAINT FK_RESERVA_GRUPO FOREIGN KEY(GRUPO_ID) REFERENCES PUBLIC.GRUPO(ID))
ALTER TABLE PUBLIC.RESERVA ALTER COLUMN ID RESTART WITH 6
CREATE MEMORY TABLE PUBLIC.CHECK_REGISTRO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,RESERVA_ID BIGINT NOT NULL,USUARIO_ID BIGINT NOT NULL,TIPO VARCHAR(10) NOT NULL,FECHA_HORA TIMESTAMP NOT NULL,ESTADO_MASCOTA VARCHAR(500),OBSERVACIONES VARCHAR(2000),CONSTRAINT CK_CHECK_REGISTRO_TIPO CHECK((PUBLIC.CHECK_REGISTRO.TIPO) IN (('ENTRADA'),('SALIDA'))),CONSTRAINT FK_CHECK_REGISTRO_RESERVA FOREIGN KEY(RESERVA_ID) REFERENCES PUBLIC.RESERVA(ID),CONSTRAINT FK_CHECK_REGISTRO_USUARIO FOREIGN KEY(USUARIO_ID) REFERENCES PUBLIC.USUARIO(ID))
ALTER TABLE PUBLIC.CHECK_REGISTRO ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.REGISTRO_DIARIO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,RESERVA_ID BIGINT NOT NULL,USUARIO_ID BIGINT NOT NULL,TIPO VARCHAR(20) NOT NULL,FECHA_HORA TIMESTAMP NOT NULL,NOTAS VARCHAR(2000),CONSTRAINT CK_REGISTRO_DIARIO_TIPO CHECK((PUBLIC.REGISTRO_DIARIO.TIPO) IN (('COMIDA'),('PASEO'),('JUEGO'),('DESCANSO'),('OTRO'))),CONSTRAINT FK_REGISTRO_DIARIO_RESERVA FOREIGN KEY(RESERVA_ID) REFERENCES PUBLIC.RESERVA(ID),CONSTRAINT FK_REGISTRO_DIARIO_USUARIO FOREIGN KEY(USUARIO_ID) REFERENCES PUBLIC.USUARIO(ID))
ALTER TABLE PUBLIC.REGISTRO_DIARIO ALTER COLUMN ID RESTART WITH 5
CREATE MEMORY TABLE PUBLIC.INCIDENCIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,RESERVA_ID BIGINT,CITA_ID BIGINT,USUARIO_ID BIGINT NOT NULL,GRAVEDAD VARCHAR(10) NOT NULL,DESCRIPCION VARCHAR(2000) NOT NULL,FECHA_HORA TIMESTAMP NOT NULL,CONSTRAINT CK_INCIDENCIA_GRAVEDAD CHECK((PUBLIC.INCIDENCIA.GRAVEDAD) IN (('LEVE'),('MODERADA'),('GRAVE'))),CONSTRAINT CK_INCIDENCIA_REFERENCIA CHECK((PUBLIC.INCIDENCIA.RESERVA_ID IS NOT NULL) OR (PUBLIC.INCIDENCIA.CITA_ID IS NOT NULL)),CONSTRAINT FK_INCIDENCIA_RESERVA FOREIGN KEY(RESERVA_ID) REFERENCES PUBLIC.RESERVA(ID),CONSTRAINT FK_INCIDENCIA_USUARIO FOREIGN KEY(USUARIO_ID) REFERENCES PUBLIC.USUARIO(ID))
ALTER TABLE PUBLIC.INCIDENCIA ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.NOTIFICACION(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,TUTOR_ID BIGINT NOT NULL,TIPO VARCHAR(80) NOT NULL,MENSAJE VARCHAR(2000) NOT NULL,LEIDA BOOLEAN DEFAULT FALSE NOT NULL,CREADA_EN TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,CONSTRAINT FK_NOTIFICACION_TUTOR FOREIGN KEY(TUTOR_ID) REFERENCES PUBLIC.TUTOR(ID))
ALTER TABLE PUBLIC.NOTIFICACION ALTER COLUMN ID RESTART WITH 4
