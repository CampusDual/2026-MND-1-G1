ALTER TABLE PUBLIC.RESUMEN_DIARIO ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.SERVICIO_PELUQUERIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,CENTRO_ID BIGINT NOT NULL,NOMBRE VARCHAR(120) NOT NULL,DURACION_MIN INTEGER NOT NULL,PRECIO NUMERIC(10,2) NOT NULL,ACTIVO BOOLEAN DEFAULT TRUE NOT NULL,CONSTRAINT CK_SERVICIO_PELUQUERIA_DURACION CHECK(PUBLIC.SERVICIO_PELUQUERIA.DURACION_MIN>0),CONSTRAINT CK_SERVICIO_PELUQUERIA_PRECIO CHECK(PUBLIC.SERVICIO_PELUQUERIA.PRECIO>=0),CONSTRAINT FK_SERVICIO_PELUQUERIA_CENTRO FOREIGN KEY(CENTRO_ID) REFERENCES PUBLIC.CENTRO(ID))
ALTER TABLE PUBLIC.SERVICIO_PELUQUERIA ALTER COLUMN ID RESTART WITH 4
CREATE MEMORY TABLE PUBLIC.FICHA_PELUQUERIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_ID BIGINT NOT NULL,TIPO_PELO VARCHAR(120),NOTAS VARCHAR(2000),UNIQUE(PERRO_ID),CONSTRAINT FK_FICHA_PELUQUERIA_PERRO FOREIGN KEY(PERRO_ID) REFERENCES PUBLIC.PERRO(ID))
ALTER TABLE PUBLIC.FICHA_PELUQUERIA ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.DISPONIBILIDAD_PELUQUERO(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,USUARIO_ID BIGINT NOT NULL,DIA_SEMANA SMALLINT NOT NULL,HORA_INICIO TIME NOT NULL,HORA_FIN TIME NOT NULL,CONSTRAINT CK_DISPONIBILIDAD_DIA CHECK((PUBLIC.DISPONIBILIDAD_PELUQUERO.DIA_SEMANA>=1) AND (PUBLIC.DISPONIBILIDAD_PELUQUERO.DIA_SEMANA<=7)),CONSTRAINT CK_DISPONIBILIDAD_HORAS CHECK(PUBLIC.DISPONIBILIDAD_PELUQUERO.HORA_FIN>PUBLIC.DISPONIBILIDAD_PELUQUERO.HORA_INICIO),CONSTRAINT FK_DISPONIBILIDAD_PELUQUERO_USUARIO FOREIGN KEY(USUARIO_ID) REFERENCES PUBLIC.USUARIO(ID))
