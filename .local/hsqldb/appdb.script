ALTER TABLE PUBLIC.SOLICITUD_PELUQUERIA ALTER COLUMN ID RESTART WITH 2
CREATE MEMORY TABLE PUBLIC.CITA_PELUQUERIA(ID BIGINT GENERATED BY DEFAULT AS IDENTITY(START WITH 0) NOT NULL PRIMARY KEY,PERRO_ID BIGINT NOT NULL,PELUQUERO_ID BIGINT NOT NULL,SOLICITUD_ID BIGINT,INICIO TIMESTAMP NOT NULL,DURACION_MIN INTEGER NOT NULL,LUGAR VARCHAR(20) NOT NULL,ESTADO VARCHAR(20) DEFAULT 'SOLICITADA' NOT NULL,CONSTRAINT CK_CITA_PELUQUERIA_DURACION CHECK(PUBLIC.CITA_PELUQUERIA.DURACION_MIN>0),CONSTRAINT CK_CITA_PELUQUERIA_LUGAR CHECK((PUBLIC.CITA_PELUQUERIA.LUGAR) IN (('EN_INSTALACIONES'),('DESPLAZADO'))),CONSTRAINT CK_CITA_PELUQUERIA_ESTADO CHECK((PUBLIC.CITA_PELUQUERIA.ESTADO) IN (('SOLICITADA'),('CONFIRMADA'),('COMPLETADA'),('CANCELADA'))),CONSTRAINT FK_CITA_PELUQUERIA_PERRO FOREIGN KEY(PERRO_ID) REFERENCES PUBLIC.PERRO(ID),CONSTRAINT FK_CITA_PELUQUERIA_PELUQUERO FOREIGN KEY(PELUQUERO_ID) REFERENCES PUBLIC.USUARIO(ID),CONSTRAINT FK_CITA_PELUQUERIA_SOLICITUD FOREIGN KEY(SOLICITUD_ID) REFERENCES PUBLIC.SOLICITUD_PELUQUERIA(ID))
ALTER TABLE PUBLIC.CITA_PELUQUERIA ALTER COLUMN ID RESTART WITH 3
CREATE MEMORY TABLE PUBLIC.CITA_SERVICIO(CITA_ID BIGINT NOT NULL,SERVICIO_ID BIGINT NOT NULL,CONSTRAINT PK_CITA_SERVICIO PRIMARY KEY(CITA_ID,SERVICIO_ID),CONSTRAINT FK_CITA_SERVICIO_CITA FOREIGN KEY(CITA_ID) REFERENCES PUBLIC.CITA_PELUQUERIA(ID),CONSTRAINT FK_CITA_SERVICIO_SERVICIO FOREIGN KEY(SERVICIO_ID) REFERENCES PUBLIC.SERVICIO_PELUQUERIA(ID))
